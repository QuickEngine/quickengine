{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"buildCommand": "pnpm build",
	"outputDirectory": "public",
	"functions": {
		"api/index.ts": {
			"includeFiles": "dist/**",
			"maxDuration": 60
		}
	},
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/api"
		}
	]
}
