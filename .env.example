# QuickEngine Software local development
DATABASE_URL="postgresql://quickengine:quickengine_dev_password@localhost:5435/quickengine"
# Cost guardrail: set "true" ONLY on the production env, paired with the prod
# DATABASE_URL. Blocks preview/dev deploys from booting against prod. See
# internal/COST_GUARDRAILS.md. Leave unset locally.
DATABASE_IS_PRODUCTION=""
# Optional runtime overrides; safe defaults are pool 2 in production (10 locally),
# connect 10s, idle 20s, max lifetime 30m, statement 30s, lock 5s, idle transaction 15s.
DATABASE_POOL_MAX=""
DATABASE_CONNECT_TIMEOUT_SECONDS=""
DATABASE_IDLE_TIMEOUT_SECONDS=""
DATABASE_MAX_LIFETIME_SECONDS=""
DATABASE_STATEMENT_TIMEOUT_MS=""
DATABASE_LOCK_TIMEOUT_MS=""
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=""
REDIS_URL="redis://localhost:6381"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
NODE_ENV="development"

# Better Auth
BETTER_AUTH_SECRET="00000000000000000000000000000000"
BETTER_AUTH_URL="http://localhost:3002"
# Prod only: parent domain for cross-subdomain session cookies (e.g. ".quickengine.xyz").
# Leave empty locally and on *.vercel.app (cookies can't span vercel.app subdomains).
AUTH_COOKIE_DOMAIN=""
NEXT_PUBLIC_QUICKENGINE_AUTH_URL="http://localhost:3002"
INITIAL_ADMIN_EMAILS=""

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Server-side application origins (used by Better Auth and API CORS)
NEXT_PUBLIC_QUICKENGINE_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_QUICKENGINE_ACCOUNT_URL="http://localhost:3001"
NEXT_PUBLIC_QUICKDASH_WEB_URL="http://localhost:3010"
NEXT_PUBLIC_QUICKDASH_ADMIN_URL="http://localhost:3011"

# Shared Vite browser contract
VITE_WEB_URL="http://localhost:3000"
VITE_ACCOUNT_URL="http://localhost:3001"
VITE_AUTH_URL="http://localhost:3002"
VITE_DASH_URL="http://localhost:3011"
VITE_API_URL="http://localhost:3020"
# Local app-specific DSNs. Deployed Vercel projects each use `VITE_SENTRY_DSN`.
VITE_WEB_SENTRY_DSN=""
VITE_AUTH_SENTRY_DSN=""
VITE_ACCOUNT_SENTRY_DSN=""
VITE_DASH_SENTRY_DSN=""
VITE_SHOP_SENTRY_DSN=""
VITE_HELP_SENTRY_DSN=""
VITE_PUSHER_KEY=""
VITE_PUSHER_CLUSTER=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# Email
RESEND_API_KEY=""
# Outbound sender on a Resend-verified domain (prod). Unset falls back to
# onboarding@resend.dev, which only delivers to the Resend account owner.
EMAIL_FROM=""
RESEND_WEBHOOK_SECRET=""

# Jobs
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Production only: forces Vercel/Inngest syncs to use the stable API custom domain.
# The public origin Inngest calls back on. Required behind a proxy: without it
# the SDK infers its own URL from request headers and registers one Inngest
# cannot reach. `API_BASE_URL` is accepted as a fallback.
INNGEST_SERVE_ORIGIN=""

# Monitoring
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Storage
# Vercel Blob uses short-lived OIDC credentials when the store is connected to
# a Vercel project. BLOB_READ_WRITE_TOKEN remains the fallback for local or
# non-Vercel runtimes that cannot use OIDC.
BLOB_STORE_ID=""
VERCEL_OIDC_TOKEN=""
BLOB_READ_WRITE_TOKEN=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# Search
ALGOLIA_APP_ID=""
ALGOLIA_SEARCH_KEY=""
ALGOLIA_ADMIN_KEY=""

# Realtime
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Per-plan Stripe price IDs (price_...). Convention: STRIPE_PRICE_<PLAN>_<CYCLE>.
# Tier names are placeholders and amounts live in Stripe; leave unset until priced.
STRIPE_PRICE_LAUNCH_MONTHLY=""
STRIPE_PRICE_LAUNCH_ANNUAL=""
STRIPE_PRICE_GROW_MONTHLY=""
STRIPE_PRICE_GROW_ANNUAL=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_ANNUAL=""
