# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
out/
build
dist

# Removed Turborepo starter paths
apps/web/
apps/docs/
packages/eslint-config/
packages/typescript-config/

# Internal company docs (private, never tracked). Root-anchored so it only matches the
# repo-root internal/ folder, never a nested internal/ dir elsewhere.
/internal/

# Local agent/workspace state
.agents/
.codex/

# Playwright (generated per run — reports, traces, screenshots)
playwright-report/
test-results/
blob-report/
.playwright/
# Saved storageState holds a REAL signed-in session cookie — never commit it.
.auth/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
*.tsbuildinfo

# ⚠️ `routeTree.gen.ts` is NOT ignored, despite being generated.
#
# It was ignored once, and every app that predates that rule has it committed
# anyway — gitignore only applies to files git is not already tracking. So four
# apps had it and the fifth silently did not, and CI failed on the new one with
# "Cannot find module './routeTree.gen'".
#
# It has to be committed: `typecheck` runs `tsc --noEmit` without building
# first, so nothing regenerates the file in CI. Committing it is the choice this
# repository already made; the ignore rule just hid that from the next app.

