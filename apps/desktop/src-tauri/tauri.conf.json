{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "QuickDash",
	"version": "0.1.0",
	"identifier": "xyz.quickdash.desktop",
	"build": {
		"devUrl": "http://localhost:3011",
		"frontendDist": "https://quickdash.xyz"
	},
	"app": {
		"windows": [
			{
				"title": "QuickDash",
				"width": 1280,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["quickdash"]
			}
		},
		"updater": {
			"endpoints": [
				"https://quickdash.xyz/releases/desktop/{{target}}-{{arch}}.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNzk3RUVCMjQ0REI5RDYKUldUV3VVMGs2MzU1cnRuWXV3Z3FQVk5ZVDduVmVPVGQzUWpzU2k0Y0N3ZUFLYkRZK0RuVXVJN0MK"
		}
	}
}
