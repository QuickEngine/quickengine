{
	"name": "@quickengine/cli",
	"version": "0.1.0",
	"description": "The `quick` command-line tool for QuickEngine and QuickDash",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/QuickEngine/quickengine.git",
		"directory": "packages/cli"
	},
	"homepage": "https://quickengine.xyz",
	"bugs": {
		"url": "https://github.com/QuickEngine/quickengine/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"bin": {
		"quick": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --clean",
		"dev": "tsup src/index.ts --format esm --watch",
		"clean": "rm -rf dist",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"@quickengine/quick": "workspace:*",
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@quickengine/config": "workspace:*",
		"tsup": "^8.4.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"license": "UNLICENSED"
}
