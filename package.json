{
	"name": "quickengine",
	"version": "0.1.0",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"overrides": {
			"@hono/node-server@<2.0.5": "^2.0.12",
			"brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
			"esbuild": "0.28.1",
			"fast-uri": "^3.1.5",
			"hono@<4.12.34": "^4.12.34",
			"ip-address": "^10.3.1",
			"js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
			"postcss": "8.5.23",
			"sharp": "^0.35.0",
			"undici@>=6.0.0 <6.28.0": "^6.28.0",
			"undici@>=7.0.0 <7.29.0": "^7.29.0"
		},
		"onlyBuiltDependencies": [
			"@sentry/cli"
		]
	},
	"scripts": {
		"dev": "pnpm docker:up:wait && turbo dev --filter=@quickengine/web --filter=@quickengine/auth-app --filter=@quickengine/account --filter=@quickengine/quickdash --filter=@quickengine/portal --filter=@quickengine/api",
		"dev:apps": "turbo dev --filter=@quickengine/web --filter=@quickengine/auth-app --filter=@quickengine/account --filter=@quickengine/quickdash --filter=@quickengine/api",
		"dev:all": "pnpm docker:up:wait && turbo dev",
		"dev:quickengine": "turbo dev --filter=@quickengine/web --filter=@quickengine/auth-app --filter=@quickengine/account --filter=@quickengine/api",
		"dev:quickdash": "turbo dev --filter=@quickengine/quickdash --filter=@quickengine/api",
		"dev:app": "turbo dev --filter=@quickengine/auth-app --filter=@quickengine/account --filter=@quickengine/quickdash --filter=@quickengine/api",
		"web": "pnpm --filter @quickengine/web dev",
		"dash": "turbo dev --filter=@quickengine/quickdash --filter=@quickengine/api",
		"account": "turbo dev --filter=@quickengine/account --filter=@quickengine/api",
		"auth": "turbo dev --filter=@quickengine/auth-app --filter=@quickengine/api",
		"api": "pnpm --filter @quickengine/api dev",
		"prepare": "husky",
		"build": "turbo build",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"check": "biome check . && pnpm check:no-next && pnpm check:error-maps && pnpm check:test-db-names && pnpm check:security-headers && pnpm check:recovery-safety && pnpm check:environment-isolation",
		"check:error-maps": "node .github/ci/check-error-maps.mjs",
		"brand:sync": "node packages/ui/sync-brand.mjs && biome check --write packages/ui/src/components",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"test:api": "pnpm --filter @quickengine/api test",
		"test:release": "node --test .github/release/*.test.mjs",
		"ci:local": "act push",
		"ci:local:ci": "act push --workflows .github/workflows/ci.yml",
		"ci:local:release": "act push --workflows .github/workflows/release.yml",
		"ci:local:secrets": "act push --workflows .github/workflows/secrets-scan.yml",
		"db:generate": "pnpm --filter @quickengine/db db:generate",
		"db:restore-drill": "pnpm --filter @quickengine/db db:restore-drill",
		"db:migrate": "pnpm --filter @quickengine/db db:migrate",
		"db:push": "pnpm --filter @quickengine/db db:push",
		"db:studio": "pnpm --filter @quickengine/db db:studio",
		"docker:up": "docker compose -f docker/docker-compose.yml up -d",
		"docker:up:wait": "docker compose -f docker/docker-compose.yml up -d --wait",
		"docker:down": "docker compose -f docker/docker-compose.yml down",
		"docker:reset": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d",
		"dev:web": "pnpm --filter @quickengine/web dev",
		"dev:auth": "pnpm --filter @quickengine/auth-app dev",
		"dev:account": "pnpm --filter @quickengine/account dev",
		"dev:dash": "pnpm --filter @quickengine/quickdash dev",
		"dev:api": "pnpm --filter @quickengine/api dev",
		"user": "pnpm --filter @quickengine/account dev",
		"portal": "pnpm --filter @quickengine/portal dev",
		"portal:key": "pnpm --filter @quickengine/api exec tsx scripts/mint-publishable-key.mts",
		"portal:enable": "pnpm --filter @quickengine/api exec tsx scripts/enable-portal.mts",
		"proof:gemsutopia": "pnpm --filter @quickengine/api exec tsx scripts/seed-gemsutopia-proof.mts",
		"proof:gemsutopia:customers": "pnpm --filter @quickengine/api exec tsx scripts/prove-gemsutopia-customers.mts",
		"proof:gemsutopia:lifecycle": "pnpm --filter @quickengine/api exec tsx scripts/prove-gemsutopia-lifecycle.mts",
		"check:no-next": "node .github/ci/check-no-next.mjs",
		"check:security-headers": "node .github/ci/check-security-headers.mjs",
		"check:recovery-safety": "node --test packages/db/recovery-safety.test.mjs",
		"db:migration-parity": "pnpm --filter @quickengine/db db:migration-parity",
		"db:tenant-recovery": "pnpm --filter @quickengine/db db:tenant-recovery",
		"check:test-db-names": "node .github/ci/check-test-db-names.mjs",
		"outbox:drain": "pnpm --filter @quickengine/api exec tsx scripts/drain-outbox.mts",
		"order:paid": "pnpm --filter @quickengine/api exec tsx scripts/emit-order-paid.mts",
		"supplier:webhook": "pnpm --filter @quickengine/api exec tsx scripts/deliver-supplier-webhook.mts",
		"check:environment-isolation": "node .github/ci/check-environment-isolation.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@types/node": "^22.15.3",
		"dotenv": "^16.6.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"turbo": "^2.10.0",
		"typescript": "5.9.2"
	}
}
