{
	"name": "@quickengine/db",
	"version": "0.1.0",
	"license": "UNLICENSED",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./health": "./src/health.ts",
		"./drizzle": "./src/drizzle.ts",
		"./schema": "./src/schema/index.ts",
		"./schema/*": "./src/schema/*.ts",
		"./testing": "./src/testing.ts"
	},
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format . --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "node push.mjs",
		"db:studio": "drizzle-kit studio",
		"db:parity": "node --env-file=../../.env.local parity.mjs",
		"db:migration-parity": "node --env-file=../../.env.local migration-parity.mjs",
		"db:migration-parity:ci": "node migration-parity.mjs",
		"db:restore-drill": "node --env-file=../../.env.local restore-drill.mjs",
		"db:tenant-recovery": "node --env-file=../../.env.local tenant-recovery.mjs",
		"test:recovery-safety": "node --test recovery-safety.test.mjs"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.0.2",
		"@quickengine/api-contracts": "workspace:*",
		"@quickengine/env": "workspace:*",
		"drizzle-orm": "^0.45.1",
		"postgres": "^3.4",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@quickengine/config": "workspace:*",
		"dotenv": "^17",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.23.0",
		"typescript": "7.0.2",
		"vitest": "^4.1.11",
		"@vercel/blob": "^2.6.1"
	}
}
