{
	"extends": "@quickengine/config/tsconfig/vite",
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"next/link": ["./src/compat/next-link.tsx"],
			"next/navigation": ["./src/compat/next-navigation.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
	"exclude": ["node_modules", "dist", "app"]
}
