{
	"name": "quickengine",
	"version": "0.1.0",
	"private": true,
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"overrides": {
			"brace-expansion@>=5.0.0 <5.0.8": "5.0.8",
			"esbuild": "0.28.1",
			"fast-uri": "^3.1.4",
			"postcss": "8.5.18",
			"sharp": "^0.35.0"
		},
		"onlyBuiltDependencies": [
			"@sentry/cli"
		]
	},
	"scripts": {
		"dev": "pnpm docker:up:wait && turbo dev --filter=@quickengine/web --filter=@quickengine/auth-app --filter=@quickengine/account --filter=@quickengine/quickdash --filter=@quickengine/api",
		"dev:apps": "turbo dev --filter=@quickengine/web --filter=@quickengine/auth-app --filter=@quickengine/account --filter=@quickengine/quickdash --filter=@quickengine/api",
		"dev:all": "pnpm docker:up:wait && turbo dev",
		"dev:quickengine": "turbo dev --filter=@quickengine/web --filter=@quickengine/auth-app --filter=@quickengine/account",
		"dev:quickdash": "turbo dev --filter=@quickengine/quickdash",
		"dev:app": "turbo dev --filter=@quickengine/auth-app --filter=@quickengine/account --filter=@quickengine/quickdash",
		"web": "pnpm --filter @quickengine/web dev",
		"dash": "pnpm --filter @quickengine/quickdash dev",
		"account": "pnpm --filter @quickengine/account dev",
		"auth": "pnpm --filter @quickengine/auth-app dev",
		"api": "pnpm --filter @quickengine/api dev",
		"prepare": "husky",
		"build": "turbo build",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"check": "biome check . && pnpm check:next-boundaries && pnpm check:error-maps",
		"check:next-boundaries": "node .github/ci/check-next-boundaries.mjs",
		"check:error-maps": "node .github/ci/check-error-maps.mjs",
		"brand:sync": "node packages/ui/sync-brand.mjs && biome check --write packages/ui/src/components",
		"typecheck": "turbo typecheck",
		"test": "turbo test && pnpm test:boundaries",
		"test:api": "pnpm --filter @quickengine/api test",
		"test:boundaries": "node --test .github/ci/check-next-boundaries.test.mjs",
		"test:release": "node --test .github/release/*.test.mjs",
		"ci:local": "act push",
		"ci:local:ci": "act push --workflows .github/workflows/ci.yml",
		"ci:local:release": "act push --workflows .github/workflows/release.yml",
		"ci:local:secrets": "act push --workflows .github/workflows/secrets-scan.yml",
		"db:generate": "pnpm --filter @quickengine/db db:generate",
		"db:restore-drill": "node packages/db/restore-drill.mjs",
		"db:migrate": "pnpm --filter @quickengine/db db:migrate",
		"db:push": "pnpm --filter @quickengine/db db:push",
		"db:studio": "pnpm --filter @quickengine/db db:studio",
		"docker:up": "docker compose -f docker/docker-compose.yml up -d",
		"docker:up:wait": "docker compose -f docker/docker-compose.yml up -d --wait",
		"docker:down": "docker compose -f docker/docker-compose.yml down",
		"docker:reset": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d",
		"dev:web": "pnpm --filter @quickengine/web dev",
		"dev:auth": "pnpm --filter @quickengine/auth-app dev",
		"dev:account": "pnpm --filter @quickengine/account dev",
		"dev:dash": "pnpm --filter @quickengine/quickdash dev",
		"dev:api": "pnpm --filter @quickengine/api dev"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^22.15.3",
		"dotenv": "^16.6.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"turbo": "^2.10.0",
		"typescript": "5.9.2"
	}
}
