{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Vite + React",
	"extends": "./base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["vite/client"]
	}
}
